# G.E.I. Agent Environment Configuration
# Copy this file to .env and fill in your values

# ========================================
# OpenAI API Key (Voice Control Required)
# Get free key at: https://platform.openai.com/api-keys
# ========================================
OPENAI_API_KEY=

# ========================================
# Cesium Ion Token (3D Terrain & 3D Cities)
# Community/Personal use is FREE - get one here:
# https://cesium.com/ion/signup
# Use a public "assets:read" token for non-commercial use
# ========================================
CESIUM_ACCESS_TOKEN=

# ========================================
# Google Maps API Key (Optional - for metered features)
# Get key at: https://console.cloud.google.com/
# Must enable billing and URL-restrict the key
# ========================================
GOOGLE_MAPS_API_KEY=

# ========================================
# AISStream Token (Ship Tracking)
# Free signup required: https://aisstream.io
# ========================================
AISSTREAM_TOKEN=

# ========================================
# OpenSky Network (Aircraft Tracking)
# Anonymous access is free. OAuth for higher limits.
# See: https://opensky-network.org/about/api/
# ========================================
OPENSKY_OAUTH_CLIENT_ID=
OPENSKY_OAUTH_CLIENT_SECRET=
OPENSKY_MODE=anon

# ========================================
# Rate Limiting (Protect against abuse)
# Adjust these if sharing with friends on LAN
# ========================================
GEV_RATELIMIT_OPENAI_PER_MIN=5      # Requests per minute to OpenAI
GEV_RATELIMIT_GOOGLE_PER_MIN=10     # Requests per minute to Google

# ========================================
# Server Configuration
# Leave commented for localhost-only (secure default)
# Uncomment and set value to enable LAN access
# ========================================
# HOST=0.0.0.0                       # Change from 'localhost' to all interfaces
# PORT=4173                          # Port number (default: 4173)

# ========================================
# Cesium Ion Billing Controls
# Enable billing alerts to avoid surprise charges
# Set BUDGET_AMOUNT and BUDGET_CURRENCY to your preferred limits
# ========================================
# CESIUM_BILLING_ENABLED=true
# CESIUM_BUDGET_AMOUNT=50           # Monthly budget in USD
# CESIUM_BUDGET_CURRENCY=USD

# ========================================
# Session Spend Cap (OpenAI)
# Hard cap on OpenAI session costs ($ default: $5)
# Set to 0 for unlimited (NOT RECOMMENDED!)
# ========================================
GEV_OPENAI_SPEND_CAP=5

# ========================================
# Debug / Development Flags
# ========================================
DEBUG=false
VITE_DEV_SERVER=true
